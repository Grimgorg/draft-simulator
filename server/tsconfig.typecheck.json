// tsconfig.json leaves test files and scripts out of the emitted build, and
// tsx strips types without checking them. This config checks all of src,
// tests included, and scripts/, without emitting anything.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "scripts"],
  "exclude": []
}

{
  "name": "@draft-simulator/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "import-cards": "tsx src/cardData/importBulkData.ts",
    "build:exe": "tsx scripts/buildExecutable.ts",
    "smoke-test-exe": "tsx scripts/smokeTestExecutable.ts",
    "test": "node --import tsx --test",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@draft-simulator/shared": "*",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

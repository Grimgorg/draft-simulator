{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draft Simulator",
  "version": "../../package.json",
  "identifier": "io.github.grimgorg.draft-simulator",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "node scripts/devServers.ts",
      "wait": false
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Self-hosted cube draft simulator for a small group of friends.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFQzY3RTUyMDA1RTA3Q0MKUldUTUIxNEFVbjdHYnBoU0lZQjFzeTdUTEJuVXRDa0MwR1RrbUpkK1dWbWxuR1JKSkUvTE5XUTgK",
      "endpoints": [
        "https://github.com/Grimgorg/draft-simulator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

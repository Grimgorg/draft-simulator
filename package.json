{
  "name": "draft-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Magic: The Gathering cube draft simulator for a small group of friends.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:shared": "npm run build --workspace shared"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
